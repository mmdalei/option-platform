# Copy this file to ".env" (same folder as main.py) and edit. Every line is optional.

# live = real TSETMC data (needs an Iranian connection) | demo = synthetic data
OPTIONS_SOURCE=live
POLL_INTERVAL_SECONDS=5

# Model assumptions - set these to your own view, they are not market facts
RISK_FREE_RATE=0.30
DIVIDEND_YIELD=0
# Premium that feeds the IV solver: mid | last | close
IV_PRICE_SOURCE=mid
# Price that counts as "spot": last | close
UNDERLYING_PRICE_SOURCE=last

# Storage: SQLite by default; Redis is optional (falls back to an in-process cache)
DATABASE_URL=sqlite:///./options.db
# REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
